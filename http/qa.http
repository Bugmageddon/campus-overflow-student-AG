POST http://127.0.0.1:8080/api/v1/auth/register
Content-Type: application/json
X-XSRF-TOKEN: {{csrf}}

{
  "username": "{{userB}}",
  "displayName": "冒烟乙{{suffix}}",
  "email": "{{userB}}@example.com",
  "password": "{{password}}",
  "college": "计算机学院",
